generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  password      String
  name          String?
  image         String?
  phone         String?
  role          Role           @default(ASESOR)
  fcmToken      String?
  leads         Lead[]         @relation("AssignedLeads")
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum Role {
  ASESOR
  ADMIN
}

model Lead {
  id           String    @id @default(uuid())
  contactId    String?
  firstName    String?
  lastName     String?
  phone        String?
  email        String?   @unique
  businessName String?
  city         String?
  source       String?
  status       String    @default("NEW")
  tags         String?
  lastActivity String?
  assignedToId String?
  assignedTo   User?     @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes        String?
  visited      Boolean   @default(false)
  visitDate    DateTime?
  visitProject String?
  lote         String?
  etapa        String?
  interests    String?
  rating       String?   @default("FRIO")
  lastNoteAt   DateTime?
  
  // UTM Parameters for web leads
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  adId         String?
  adName       String?
  formId       String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("INFO")
  leadId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
